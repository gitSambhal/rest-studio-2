{
  "name": "reststudio-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "tauri:dev": "npm run build && tauri dev",
    "tauri:build": "npm run build && tauri build",
    "neu:dev": "node scripts/build-neu.js && npx @neutralinojs/neu run",
    "neu:build": "node scripts/build-neu.js",
    "build": "node scripts/generate-icons.js && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:tauri": "npm run build && tauri build",
    "build:neu": "node scripts/build-neu.js",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); ['dist', 'src-tauri/target', '.neu', 'server.js'].forEach(d => fs.rmSync(d, {recursive: true, force: true}));\"",
    "prebuild": "npm run clean",
    "lint": "tsc --noEmit",
    "test:build": "npm run build:neu && node scripts/test-build.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.19.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
